# Local development environment variables.
# These must also be configured in the relevant Twilio Functions Service environment.

# -----------------------------------------------------------------------------
# Twilio
# -----------------------------------------------------------------------------

ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Runtime domain of the deployed Twilio Functions Service.
# This is automatically provided by Twilio when deployed, but is required locally.
DOMAIN_NAME=


# -----------------------------------------------------------------------------
# HubSpot
# -----------------------------------------------------------------------------

# HubSpot Calling App ID used when creating and managing HubSpot call records.
HUBSPOT_APP_ID=

# External account identifier associated with calls created by the Calling integration.
HUBSPOT_EXTERNAL_ACCOUNT_ID=

# HubSpot OAuth application credentials.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# OAuth refresh token used to obtain HubSpot access tokens.
HUBSPOT_REFRESH_TOKEN=


# -----------------------------------------------------------------------------
# Agent routing
# -----------------------------------------------------------------------------

# JSON array of HubSpot agent phone numbers available to receive calls.
# Example: ["+15551234567","+15557654321"]
AGENT_NUMBERS=


# -----------------------------------------------------------------------------
# Studio
# -----------------------------------------------------------------------------

# Twilio Studio Flow webhook URL used to return control to the Studio Flow.
WEBHOOK_URL=


# -----------------------------------------------------------------------------
# Recording authentication
# -----------------------------------------------------------------------------

# Secret used to sign and verify temporary JWTs for authenticated recording access.
# Generate a strong random value separately for each environment.
SHARED_SECRET=


# -----------------------------------------------------------------------------
# County routing
# -----------------------------------------------------------------------------

# Phone number for each county used by the Main IVR county-routing journey.
# Store numbers in E.164 format, e.g. +16095551234.
ATLANTIC_NUMBER=
BERGEN_NUMBER=
BURLINGTON_NUMBER=
CAMDEN_NUMBER=
CAPE_MAY_NUMBER=
CUMBERLAND_NUMBER=
ESSEX_NUMBER=
GLOUCESTER_NUMBER=
HUDSON_NUMBER=
HUNTERDON_NUMBER=
MERCER_NUMBER=
MIDDLESEX_NUMBER=
MONMOUTH_NUMBER=
MORRIS_NUMBER=
OCEAN_NUMBER=
PASSAIC_NUMBER=
SALEM_NUMBER=
SOMERSET_NUMBER=
SUSSEX_NUMBER=
UNION_NUMBER=
WARREN_NUMBER=

# Fallback number used when a specific county number is not available/configured.
DEFAULT_NUMBER=